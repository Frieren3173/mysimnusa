// RSAJT Nursing Management System - Prisma Schema
// Stack: PostgreSQL + Prisma ORM
// Spec: Backend.md, Architecture.md

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// IDENTITY & AUTH
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff            Staff?
  sessions         Session[]
  userRoles        UserRole[]
  auditLogs        AuditLog[]
  migrationBatches MigrationBatch[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

/// Durable login rate-limiting counters. One row per key, where a key is either
/// `ip:<ip>` or `user:<lowercased-username>`. `count` is incremented atomically
/// on each failed attempt within `windowStart`; `lockedUntil` blocks further
/// attempts once the limit is hit. Serverless-safe (no in-memory state).
model LoginAttempt {
  id           String    @id @default(cuid())
  key          String    @unique
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  resetAt      DateTime
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([resetAt])
  @@index([lockedUntil])
  @@map("login_attempts")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SUPER_ADMIN, ADMIN_KOMITE, ADMIN_BORANG, ADMIN_DIKLAT, VERIFIER, STAFF, VIEWER
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique // module.resource.action e.g. komite.staff.read
  module   String
  resource String
  action   String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]

  @@map("departments")
}

model Room {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique
  type         String?
  /// Canonical grouping for Borang master: RAWAT INAP | IBS / BEDAH |
  /// KEGAWATDARURATAN | RAWAT JALAN | MANAGEMENT
  category     String?
  /// Fine-grained subcategory under the category, e.g. VK/KEBIDANAN ->
  /// KEBIDANAN, HD -> HEMODIALISA, CATHLAB -> KATETERISASI / CARDIAC PROCEDURE
  subcategory  String?
  description  String?
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department     Department?         @relation(fields: [departmentId], references: [id])
  staff          Staff[]
  borangEntries  BorangEntry[]
  nursingActions RoomNursingAction[]

  @@index([category])
  @@map("rooms")
}

// ─────────────────────────────────────────────
// MASTER TINDAKAN KEPERAWATAN (BORANG)
// ─────────────────────────────────────────────

model NursingAction {
  id          String   @id @default(cuid())
  code        String   @unique
  /// Action identity for the master catalogue — must be unique to prevent
  /// duplicate actions (room + action uniqueness is enforced by
  /// RoomNursingAction's compound unique key).
  name        String   @unique
  category    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms   RoomNursingAction[]
  entries BorangEntry[]

  @@map("nursing_actions")
}

model RoomNursingAction {
  id              String   @id @default(cuid())
  roomId          String
  nursingActionId String
  createdAt       DateTime @default(now())

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  nursingAction NursingAction @relation(fields: [nursingActionId], references: [id], onDelete: Cascade)

  @@unique([roomId, nursingActionId])
  @@index([nursingActionId])
  @@map("room_nursing_actions")
}

// ─────────────────────────────────────────────
// STAFF — Unified Entity
// ─────────────────────────────────────────────

model Staff {
  id               String    @id @default(cuid())
  userId           String?   @unique
  nip              String?   @unique
  name             String
  email            String?
  phone            String?
  address          String?
  dateOfBirth      DateTime?
  profession       String // Perawat, Bidan, dll
  roomId           String?
  employmentStatus String    @default("ACTIVE") // ACTIVE, INACTIVE, RESIGNED, RETIRED
  photoUrl         String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Migration tracking
  legacySourceId String?
  importedAt     DateTime?

  user                 User?                 @relation(fields: [userId], references: [id])
  room                 Room?                 @relation(fields: [roomId], references: [id])
  employment           StaffEmployment?
  education            StaffEducation[]
  documents            Document[]
  competencies         StaffCompetency[]
  borangEntries        BorangEntry[]
  trainingParticipants TrainingParticipant[]
  notifications        Notification[]
  auditLogs            AuditLog[]            @relation("StaffAuditLogs")
  migrationItems       MigrationItem[]

  @@index([name])
  @@index([nip])
  @@index([profession])
  @@index([roomId])
  @@map("staff")
}

model StaffEmployment {
  id           String    @id @default(cuid())
  staffId      String    @unique
  joinDate     DateTime?
  position     String?
  employeeType String? // PNS, KONTRAK, MAGANG
  workUnit     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_employment")
}

model StaffEducation {
  id             String   @id @default(cuid())
  staffId        String
  level          String // D3, D4, S1, S2, S3, SPK
  institution    String
  major          String?
  graduationYear Int?
  documentUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_education")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model DocumentType {
  id          String   @id @default(cuid())
  code        String   @unique // STR, SIP, BTCLS, ACLS, CV, RKK, IJAZAH, FOTO, etc.
  name        String
  description String?
  hasExpiry   Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  documents Document[]

  @@map("document_types")
}

model Document {
  id              String         @id @default(cuid())
  staffId         String
  documentTypeId  String
  number          String? // nomor STR, SIP, dll
  fileId          String?
  storageKey      String?
  /// Which storage backend holds the bytes: google-drive | r2 | local
  storageProvider String?
  filename        String?
  mimeType        String?
  fileSize        Int?
  checksum        String?
  issueDate       DateTime?
  expiryDate      DateTime?
  isLifetime      Boolean        @default(false)
  status          DocumentStatus @default(MISSING)
  notes           String?
  uploadedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Migration tracking
  legacySourceId String?
  legacyDriveId  String?
  legacyDriveUrl String?
  lastSyncError  String?
  importedAt     DateTime?
  importChecksum String?

  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  @@index([staffId])
  @@index([documentTypeId])
  @@index([expiryDate])
  @@map("documents")
}

enum DocumentStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  LIFETIME
  MISSING
}

// ─────────────────────────────────────────────
// COMPETENCIES
// ─────────────────────────────────────────────

model Competency {
  id          String   @id @default(cuid())
  code        String   @unique // BEDAH, ICU, PICU, NICU, HEMODIALISA, CATHLAB, PPGDON, APN
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  staffCompetencies StaffCompetency[]

  @@map("competencies")
}

model StaffCompetency {
  id           String    @id @default(cuid())
  staffId      String
  competencyId String
  certNumber   String?
  issuedDate   DateTime?
  expiryDate   DateTime?
  documentUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id])

  @@unique([staffId, competencyId])
  @@map("staff_competencies")
}

// ─────────────────────────────────────────────
// BORANG
// ─────────────────────────────────────────────

model BorangEntry {
  id                String       @id @default(cuid())
  staffId           String
  roomId            String?
  period            String // e.g. "2024-01"
  patientIdentifier String // TN.X, NY.Y — NEVER full name
  rmNumber          String? // random medical record number (anonim)
  actionType        String
  nursingActionId   String? // nullable — old entries keep actionType string as-is
  quantity          Int          @default(1)
  notes             String?
  status            BorangStatus @default(DRAFT)
  verifierId        String?
  verifierNotes     String?
  rejectReason      String?
  submittedAt       DateTime?
  verifiedAt        DateTime?
  approvedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  staff         Staff                @relation(fields: [staffId], references: [id])
  room          Room?                @relation(fields: [roomId], references: [id])
  nursingAction NursingAction?       @relation(fields: [nursingActionId], references: [id])
  verifications BorangVerification[]
  auditLogs     AuditLog[]           @relation("BorangAuditLogs")

  @@index([staffId])
  @@index([status])
  @@index([createdAt])
  @@map("borang_entries")
}

enum BorangStatus {
  DRAFT
  SUBMITTED
  VERIFICATION
  APPROVED
  REJECTED
  ARCHIVED
}

model BorangVerification {
  id            String   @id @default(cuid())
  borangEntryId String
  verifierId    String
  action        String // SUBMITTED, VERIFIED, APPROVED, REJECTED
  notes         String?
  createdAt     DateTime @default(now())

  borangEntry BorangEntry @relation(fields: [borangEntryId], references: [id], onDelete: Cascade)

  @@map("borang_verifications")
}

// ─────────────────────────────────────────────
// DIKLAT (TRAINING)
// ─────────────────────────────────────────────

model Training {
  id           String         @id @default(cuid())
  title        String
  category     String?
  description  String?
  startDate    DateTime
  endDate      DateTime
  location     String?
  capacity     Int?
  status       TrainingStatus @default(DRAFT)
  materialUrls Json?
  createdBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  instructors  TrainingInstructor[]
  participants TrainingParticipant[]
  attendance   TrainingAttendance[]
  assessments  TrainingAssessment[]
  certificates Certificate[]

  @@map("trainings")
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

model TrainingInstructor {
  id         String   @id @default(cuid())
  trainingId String
  name       String
  title      String?
  email      String?
  createdAt  DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@map("training_instructors")
}

model TrainingParticipant {
  id           String   @id @default(cuid())
  trainingId   String
  staffId      String
  registeredAt DateTime @default(now())
  status       String   @default("REGISTERED") // REGISTERED, CONFIRMED, CANCELLED

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id])

  @@unique([trainingId, staffId])
  @@index([trainingId])
  @@index([staffId])
  @@map("training_participants")
}

model TrainingAttendance {
  id         String   @id @default(cuid())
  trainingId String
  staffId    String
  date       DateTime
  status     String // HADIR, TIDAK_HADIR, SAKIT, IZIN
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@map("training_attendance")
}

model TrainingAssessment {
  id         String   @id @default(cuid())
  trainingId String
  staffId    String
  score      Float?
  grade      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, staffId])
  @@map("training_assessments")
}

model Certificate {
  id                String   @id @default(cuid())
  trainingId        String
  staffId           String
  certificateNumber String   @unique
  issuedDate        DateTime @default(now())
  storageKey        String?
  filename          String?
  createdAt         DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id])

  @@index([trainingId])
  @@index([staffId])
  @@map("certificates")
}

// ─────────────────────────────────────────────
// CROSS-CUTTING
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  staffId   String?
  userId    String?
  type      String // STR_EXPIRING, SIP_EXPIRING, BORANG_SUBMITTED, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  staffId    String?
  borangId   String?
  module     String // komite, borang, diklat, admin
  resource   String
  resourceId String?
  action     String // CREATED, UPDATED, DELETED, SUBMITTED, APPROVED, REJECTED
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user   User?        @relation(fields: [userId], references: [id])
  staff  Staff?       @relation("StaffAuditLogs", fields: [staffId], references: [id])
  borang BorangEntry? @relation("BorangAuditLogs", fields: [borangId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// MIGRATION CENTER
// ─────────────────────────────────────────────

model MigrationConnection {
  id                 String               @id @default(cuid())
  /// SOURCE = legacy Drive/Sheets (read-only) | DESTINATION = production storage (write)
  role               GoogleConnectionRole @default(SOURCE)
  googleAccountEmail String?
  status             String               @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  scopes             Json?
  tokenEncrypted     String? // never store plaintext
  lastCheckedAt      DateTime?
  connectedBy        String?
  connectedAt        DateTime?
  disconnectedAt     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([role])
  @@map("migration_connections")
}

enum GoogleConnectionRole {
  SOURCE
  DESTINATION
}

model DriveFolder {
  id        String   @id @default(cuid())
  /// Logical folder path, e.g. "MYSIMNUSA/staff/<staffId>/str"
  path      String   @unique
  name      String
  /// Google Drive folder id
  driveId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drive_folders")
}

model MigrationBatch {
  id              String               @id @default(cuid())
  createdBy       String
  sourceType      String // GOOGLE_SHEETS, GOOGLE_DRIVE, XLSX_FILE
  sourceReference String
  status          MigrationBatchStatus @default(DRAFT)
  isDryRun        Boolean              @default(false)
  scanResult      Json?
  sourceFileKey   String?
  startedAt       DateTime?
  completedAt     DateTime?
  sourceCount     Int                  @default(0)
  createdCount    Int                  @default(0)
  updatedCount    Int                  @default(0)
  skippedCount    Int                  @default(0)
  failedCount     Int                  @default(0)
  warningCount    Int                  @default(0)
  duplicateCount  Int                  @default(0)
  reportUrl       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  createdByUser    User                       @relation(fields: [createdBy], references: [id])
  items            MigrationItem[]
  fieldMappings    MigrationFieldMapping[]
  documentMappings MigrationDocumentMapping[]
  reconciliation   MigrationReconciliation?

  @@map("migration_batches")
}

enum MigrationBatchStatus {
  DRAFT
  SCANNING
  SCANNED
  MAPPING_REVIEW
  VALIDATING
  READY
  IMPORTING
  PAUSED
  FAILED
  CANCELLED
  COMPLETED
  RECONCILING
  RECONCILED
}

model MigrationFieldMapping {
  id          String  @id @default(cuid())
  batchId     String
  sourceField String
  targetField String
  isIgnored   Boolean @default(false)
  confidence  Float? // 0.0-1.0 auto-map confidence

  batch MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceField])
  @@map("migration_field_mappings")
}

model MigrationDocumentMapping {
  id             String @id @default(cuid())
  batchId        String
  sourceField    String
  documentTypeId String
  fieldRole      String // FILE, EXPIRY_DATE, NUMBER, ISSUE_DATE

  batch MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("migration_document_mappings")
}

model MigrationItem {
  id           String              @id @default(cuid())
  batchId      String
  entityType   String // STAFF, DOCUMENT
  sourceId     String
  sourceHash   String?
  targetId     String?
  action       String? // CREATE, UPDATE, SKIP, REJECT
  status       MigrationItemStatus @default(PENDING)
  errorCode    String?
  errorMessage String?
  retryCount   Int                 @default(0)
  processedAt  DateTime?
  staffId      String?

  batch MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  staff Staff?         @relation(fields: [staffId], references: [id])

  @@unique([batchId, sourceId, entityType])
  @@index([batchId])
  @@index([status])
  @@map("migration_items")
}

enum MigrationItemStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  DUPLICATE_REVIEW
  RETRYING
}

model MigrationReconciliation {
  id                  String   @id @default(cuid())
  batchId             String   @unique
  sourceStaffCount    Int      @default(0)
  targetStaffCount    Int      @default(0)
  createdCount        Int      @default(0)
  updatedCount        Int      @default(0)
  skippedCount        Int      @default(0)
  failedCount         Int      @default(0)
  duplicateCandidates Int      @default(0)
  sourceDocumentCount Int      @default(0)
  documentsImported   Int      @default(0)
  documentsFailed     Int      @default(0)
  orphanDocuments     Int      @default(0)
  recordsMissingDocs  Int      @default(0)
  reconciledAt        DateTime @default(now())

  batch MigrationBatch @relation(fields: [batchId], references: [id])

  @@map("migration_reconciliations")
}

// ---------------------------------------------------------------------------
// STORAGE MIGRATION (file-level: old Drive -> server -> new Drive/R2)
// ---------------------------------------------------------------------------

model StorageMigrationBatch {
  id              String                 @id @default(cuid())
  createdBy       String?
  sourceProvider  String // google-drive | r2 | local
  targetProvider  String // google-drive | r2 | local
  sourceFolderId  String?
  targetFolderId  String?
  status          StorageMigrationStatus @default(DRAFT)
  optimize        Boolean                @default(true)
  targetSizeBytes Int                    @default(2097152)
  totalFiles      Int                    @default(0)
  processedFiles  Int                    @default(0)
  succeededFiles  Int                    @default(0)
  failedFiles     Int                    @default(0)
  skippedFiles    Int                    @default(0)
  savedBytes      BigInt                 @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  lastError       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  items StorageMigrationItem[]

  @@index([status])
  @@map("storage_migration_batches")
}

enum StorageMigrationStatus {
  DRAFT
  SCANNING
  READY
  RUNNING
  PAUSED
  FAILED
  COMPLETED
  CANCELLED
}

model StorageMigrationItem {
  id                String                     @id @default(cuid())
  batchId           String
  sourceFileId      String
  sourceKey         String?
  destinationFileId String?
  destinationKey    String?
  originalFilename  String
  mimeType          String?
  originalSize      Int                        @default(0)
  finalSize         Int                        @default(0)
  originalChecksum  String?
  finalChecksum     String?
  compressionStatus String? // OPTIMIZED | UNCHANGED | FAILED
  strategy          String?
  status            StorageMigrationItemStatus @default(PENDING)
  errorMessage      String?
  retryCount        Int                        @default(0)
  attempts          Int                        @default(0)
  startedAt         DateTime?
  processedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  batch StorageMigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceFileId])
  @@index([batchId])
  @@index([status])
  @@map("storage_migration_items")
}

enum StorageMigrationItemStatus {
  PENDING
  PROCESSING
  OPTIMIZED
  UPLOADED
  VERIFIED
  FAILED
  SKIPPED
}
