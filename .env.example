# MYSIMNUSA — example environment variables
#
# Copy this file to `.env` and fill in real values.
# NEVER commit real credentials. `.env*` is git-ignored.

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------
# Pooled connection (used by the running application)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct/unpooled connection (used for migrations and seeding)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon branch name (informational)
NEON_BRANCH="production"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV="development"
# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# User-facing application name
NEXT_PUBLIC_APP_NAME="MYSIMNUSA"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Random secret used to sign sessions (generate a long random string)
AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL used for auth callbacks (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google integration (optional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Cloudflare R2 — file/document storage (S3-compatible API)
# Filled in when R2 integration is enabled. Actual bucket/migration not done yet.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="mysimnusa-documents"
# Optional: public/CDN base URL for stored objects
R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Login rate limiting (defaults applied in code when unset)
# LOGIN_RATE_LIMIT_MAX="5"
# LOGIN_RATE_LIMIT_WINDOW_MS="900000"
