# MYSIMNUSA — example environment variables
#
# Copy this file to `.env` and fill in real values.
# NEVER commit real credentials. `.env*` is git-ignored.

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------
# Pooled connection (used by the running application)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct/unpooled connection (used for migrations and seeding)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon branch name (informational)
NEON_BRANCH="production"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV="development"
# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# User-facing application name
NEXT_PUBLIC_APP_NAME="MYSIMNUSA"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Random secret used to sign sessions (generate a long random string).
# REQUIRED in production; must be at least 32 characters.
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional: dedicated key for encrypting Google OAuth tokens at rest.
# If unset, a key is derived from AUTH_SECRET (SHA-256). Changing either value
# makes existing stored Google tokens undecryptable — reconnect Google after.
# TOKEN_ENCRYPTION_KEY="replace-with-another-long-random-secret"
# Public URL used for auth callbacks (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage provider
# ---------------------------------------------------------------------------
# google-drive = Google Drive (current production document storage)
# r2           = Cloudflare R2 (future provider, fully supported)
# local        = on-disk storage/ folder (development only)
# Leave unset to auto-detect: google-drive -> r2 -> local.
STORAGE_PROVIDER="google-drive"

# Root folder created inside the connected Google Drive account for documents.
GOOGLE_DRIVE_ROOT_FOLDER="MYSIMNUSA"

# ---------------------------------------------------------------------------
# Google integration (OAuth) — required for Google Drive storage + Migration Center
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Cloudflare R2 — file/document storage (S3-compatible API)
# Future provider only. Leave blank while STORAGE_PROVIDER=google-drive.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional: public/CDN base URL for stored objects
R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Login rate limiting (defaults applied in code when unset)
# LOGIN_RATE_LIMIT_MAX="5"
# LOGIN_RATE_LIMIT_WINDOW_MS="900000"
# LOGIN_RATE_LIMIT_USER_MAX="10"

# ---------------------------------------------------------------------------
# Security — Content Security Policy mode
# ---------------------------------------------------------------------------
# report-only (default) sends Content-Security-Policy-Report-Only (observes only)
# enforce               sends the blocking Content-Security-Policy header
# CSP_MODE="report-only"

# ---------------------------------------------------------------------------
# Migrations (production): apply with the UNPOOLED connection
# ---------------------------------------------------------------------------
# DATABASE_URL="$DATABASE_URL_UNPOOLED" npx prisma migrate deploy
